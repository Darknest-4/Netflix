# ─── NOVA web image ───────────────────────────────────────────────────────────
# Multi-stage build producing a Next.js standalone server: the runtime image
# ships only the server bundle and the static assets.

FROM node:22-alpine AS deps
WORKDIR /repo
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --ignore-scripts

FROM deps AS build
WORKDIR /repo
ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ARG NEXT_PUBLIC_WS_URL=http://localhost:4000
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_TELEMETRY_DISABLED=1

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build --workspace @nova/shared \
 && npm run build --workspace @nova/web

FROM node:22-alpine AS runner
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && adduser -S nova -u 1001

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

COPY --from=build /repo/apps/web/public ./apps/web/public
COPY --from=build --chown=nova:nodejs /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nova:nodejs /repo/apps/web/.next/static ./apps/web/.next/static

USER nova
EXPOSE 3000

CMD ["node", "apps/web/server.js"]
